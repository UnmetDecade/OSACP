# 复制为 .env.local 后填写；.env.local 已被 gitignore。
#
# 管理员 JWT（由 pcs-issuer 签发：npm --prefix ../pcs-issuer run pcs -- admin-token）
# 只由开发代理读取，不会进入前端包、URL 或 localStorage。
PCS_ADMIN_TOKEN=

# 开发代理目标（可选）。默认 /api/pcs -> http://127.0.0.1:7901，
# /api/scheduler -> http://127.0.0.1:8443。
# VITE_PCS_TARGET=http://127.0.0.1:7901
# VITE_SCHEDULER_TARGET=http://127.0.0.1:8443
