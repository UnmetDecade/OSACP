# Copy to .env.local and fill in; .env.local is gitignored.
#
# Admin JWT (issued by pcs-issuer: npm --prefix ../pcs-issuer run pcs -- admin-token)
# Read only by the dev proxy; never enters the frontend bundle, URLs or localStorage.
PCS_ADMIN_TOKEN=

# Dev proxy targets (optional). Defaults: /api/pcs -> http://127.0.0.1:7901,
# /api/scheduler -> http://127.0.0.1:8443.
# VITE_PCS_TARGET=http://127.0.0.1:7901
# VITE_SCHEDULER_TARGET=http://127.0.0.1:8443
