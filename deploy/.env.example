# 复制为 deploy/.env 后再改；不要提交真实密码。
POSTGRES_PASSWORD=change-me-postgres

# 调度机共享 Bearer（PCS 公钥未启用时使用）；留空则只接受 PCS 签发的实例 JWT。
SCHEDULER_AUTH_TOKEN=

# 默认绑定的 Agent Profile（不绑定就只跑确定性 Shell）。
BUILDER_AGENT_PROFILE_ID=agp_builder

# 调度机自己的 Agent（对话 / 解释队列 / 调度机容器 Shell）。
SCHEDULER_AGENT_PROFILE_ID=agp_scheduler

# 模型凭据：只注入运行时容器环境，不写进镜像和 Agent Profile。
# Claude Code 走 DeepSeek 的 Anthropic 兼容端点（镜像里已设 ANTHROPIC_BASE_URL），
# Codex 走 DeepSeek 的 Responses API（镜像里 CODEX_HOME 指向 config.toml）。
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 「容器环境 → Agent 适配器」的放行表（逗号分隔）；Profile 的 --pass-env
# 再决定哪些变量真正交给外部 CLI。留空则 Agent 拿不到任何模型凭据。
PLATFORM_AGENT_PASS_ENV=ANTHROPIC_API_KEY,ANTHROPIC_BASE_URL,DEEPSEEK_API_KEY,CODEX_HOME

# 实例领任务的轮询间隔（秒）。终端和对话的体感延迟主要来自这里：
# 任务入队后要等实例下一次来领。2 秒适合大规模；小平台用 0.5 更跟手。
CLAIM_INTERVAL_SECONDS=0.5
