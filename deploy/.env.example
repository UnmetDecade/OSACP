# Copy to deploy/.env before editing; never commit real passwords.
POSTGRES_PASSWORD=change-me-postgres

# Scheduler shared Bearer token (used when PCS public keys are not enabled); leave empty to accept only instance JWTs issued by PCS.
SCHEDULER_AUTH_TOKEN=

# Default bound Agent Profile (without one, only the deterministic shell runs).
BUILDER_AGENT_PROFILE_ID=agp_builder

# The scheduler's own Agent (chat / queue explanation / scheduler container shell).
SCHEDULER_AGENT_PROFILE_ID=agp_scheduler

# Model credentials: injected only into the runtime container environment, never baked into images or Agent Profiles.
# Claude Code uses DeepSeek's Anthropic-compatible endpoint (ANTHROPIC_BASE_URL is already set in the image),
# Codex uses DeepSeek's Responses API (CODEX_HOME points at config.toml in the image).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Allowlist from "container environment -> Agent adapter" (comma-separated); the Profile's --pass-env
# then decides which variables actually reach the external CLI. Empty means the Agent gets no model credentials.
PLATFORM_AGENT_PASS_ENV=ANTHROPIC_API_KEY,ANTHROPIC_BASE_URL,DEEPSEEK_API_KEY,CODEX_HOME

# Polling interval (seconds) for instances claiming tasks. Perceived terminal/chat latency mostly comes from here:
# after a task is enqueued, it waits for the instance's next claim. 2s suits large deployments; 0.5s feels snappier on small ones.
CLAIM_INTERVAL_SECONDS=0.5
