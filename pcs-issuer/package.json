{
  "name": "pcs-issuer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PCS control plane: host roster, deployment plans, signed commands, Agent/API profiles, and audit",
  "scripts": {
    "keygen": "node scripts/keygen.mjs",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "issue": "tsx src/issue.ts",
    "pcs": "tsx src/pcs.ts",
    "pretest": "PCS_DATABASE_URL=${PCS_DATABASE_URL_TEST:-postgres://postgres:sched_dev_pw@127.0.0.1:5432/platform_control_test} tsx src/migrate.ts",
    "test": "PCS_DATABASE_URL=${PCS_DATABASE_URL_TEST:-postgres://postgres:sched_dev_pw@127.0.0.1:5432/platform_control_test} tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
